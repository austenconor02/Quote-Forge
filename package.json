{
  "name": "quoteforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-quoteforge \"tsx --test tests/rules/*.test.ts\"",
    "postinstall": "node scripts/prepare-document-assets.mjs",
    "predev": "node scripts/prepare-document-assets.mjs",
    "prebuild": "node scripts/prepare-document-assets.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "heic2any": "0.0.4",
    "jspdf": "4.2.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tesseract.js": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "rimraf": "6.1.4"
  }
}
