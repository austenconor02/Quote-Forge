rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }
    function owner() {
      return signedIn() && request.auth.token.get('platformOwner', false) == true
        && request.auth.uid == get(/databases/$(database)/documents/platform/config).data.ownerUid;
    }
    function tenantUser(companyId) {
      return signedIn()
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.companyId == companyId
        && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'Active'
        && get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.enabled == true;
    }
    function access(companyId) { return owner() || tenantUser(companyId); }
    match /platform/config { allow get: if owner(); allow list, write: if false; }
    match /userAccess/{uid} {
      allow get: if owner() || (signedIn() && request.auth.uid == uid);
      allow list, write: if false;
    }
    // Proposal bearer tokens/hashes are resolved only by the server share endpoint.
    match /proposalShares/{id} { allow read, write: if false; }
    match /companies/{companyId} {
      allow get: if access(companyId);
      allow list: if owner();
      allow write: if false;
      match /users/{uid} {
        allow get: if owner() || (signedIn() && request.auth.uid == uid && tenantUser(companyId));
        allow list: if owner();
        allow write: if false;
      }
      match /branding/{id} { allow read: if access(companyId); allow write: if false; }
      match /fields/{id} { allow read: if access(companyId); allow write: if false; }
      match /aiConfig/{id} { allow read: if owner(); allow write: if false; }
      match /invitations/{id} { allow read: if owner(); allow write: if false; }
      match /{collection}/{id} {
        allow read: if collection in ['customers', 'quotes', 'drafts', 'documents', 'proposals'] && access(companyId);
        // Every write is validated by authenticated server APIs. Admin SDK writes bypass these rules.
        allow write: if false;
      }
    }
    // Invitation hashes, email outbox/leases, rate limits, owner bootstrap, and all unknown paths are private.
    match /{document=**} { allow read, write: if false; }
  }
}
