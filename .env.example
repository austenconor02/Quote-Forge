# Local preview runs ONLY on loopback in next dev. Production always requires auth.
QUOTEFORGE_DEMO_MODE=true
# Target only the independent QuoteForge project. Never use reference credentials.
QUOTEFORGE_FIREBASE_ENABLED=false
NEXT_PUBLIC_FIREBASE_ENABLED=false
QUOTEFORGE_USE_EMULATORS=false
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=quote-forge-b153f
FIREBASE_STORAGE_BUCKET=quote-forge-b153f.firebasestorage.app
# Prefer application default credentials; alternatively supply these server secrets.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
QUOTEFORGE_OWNER_UID=
QUOTEFORGE_OWNER_EMAIL=owner@example.com
# Enable once only for a verified Google login matching OWNER_EMAIL; its UID becomes immutable.
QUOTEFORGE_OWNER_BOOTSTRAP_ENABLED=false
# AI remains disabled until the original generation engine is supplied.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
# Email delivery is held until templates and server keys are configured.
EMAIL_DELIVERY_ENABLED=false
EMAILJS_SERVICE_ID=
EMAILJS_INVITATION_TEMPLATE_ID=
EMAILJS_PROPOSAL_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
APP_ORIGIN=http://127.0.0.1:3000
